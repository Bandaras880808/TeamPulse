@{
    ViewData["Title"] = "Team Pulse";
}

<div class="container py-4">

    <h1 class="mb-4">
        Team Pulse Dashboard
    </h1>

    <div class="row">

        <div class="col-md-12">

            <div class="card shadow-sm">

                <div class="card-header">
                    Select Team
                </div>

                <div class="card-body">

                    <div id="teamContainer"
                         class="row g-3">
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-12">

            <div class="card shadow-sm">

                <div class="card-header">
                    Who Interrupted You?
                </div>

                <div class="card-body">

                    <div id="categoryContainer"
                         class="row g-3">
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    ~/js/pulse.jsscript>
}